# ============================================================
#  Environment configuration — EXAMPLE ONLY (safe to commit)
#  Copy this file to .env and fill in real values.
#  NEVER commit the real .env file.
# ============================================================

# --- App ---
APP_NAME=Fact Knowledge Layer
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM / Embeddings provider abstraction ---
#   LLM_PROVIDER      ∈ gemini | ollama | sample   (target: gemini)
#   EMBEDDING_PROVIDER ∈ gemini | ollama | sample  (sample = deterministic tests)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# --- Ollama (local, offline-capable dev/fallback provider) ---
#   LLM:      qwen3:4b (Q4, ~2.6 GB) fits a 4 GB GPU; strong JSON/instruction following.
#   Embed:    nomic-embed-text (768-dim; zero-padded to EMBEDDING_DIM for pgvector).
#   Start with:  ollama serve  (then:  ollama pull qwen3:4b && ollama pull nomic-embed-text)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Provider API keys (leave blank to use SAMPLE/demo mode) ---
GEMINI_API_KEY=your_google_ai_studio_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=factknowledge
POSTGRES_USER=factuser
POSTGRES_PASSWORD=change_me
