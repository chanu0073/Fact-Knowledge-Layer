# ============================================================
#  Environment configuration — EXAMPLE ONLY (safe to commit)
#  Copy this file to .env and fill in real values.
#  NEVER commit the real .env file.
# ============================================================

# --- App ---
APP_NAME=Fact Knowledge Layer
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM / Embeddings provider abstraction ---
# Options: gemini | openai | anthropic | sample
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# --- Provider API keys (leave blank to use SAMPLE/demo mode) ---
GEMINI_API_KEY=your_google_ai_studio_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=factknowledge
POSTGRES_USER=factuser
POSTGRES_PASSWORD=change_me
